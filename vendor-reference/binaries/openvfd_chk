#!/bin/ash
VFD_CFG=/mnt/data/supervisor/homeassistant/custom_components/wgi_openvfd_x96max/config.yaml
VFD_EN=/usr/share/service/openvfd
VFD_ENV=/usr/share/service/openvfd_env

[ -f "$VFD_CFG" ] && {
    VFD_DISABLE=$(cat $VFD_CFG | yq .openvfd_server || echo "")
    VFD_TZ=UTC
    [ "$VFD_DISABLE" == "disable" ] && {
        [ -f $VFD_EN ] && rm -f $VFD_EN
        echo ""
        sleep 1
        exit 255
    } || {
        VFD_TZ=$(cat $VFD_CFG | yq .time_zone_name || echo "UTC")
        [ -f $VFD_EN ] && TZFILE=$(cat $VFD_ENV) || TZFILE="  "
        [ "TZ=$VFD_TZ" != "$TZFILE" ] && {
            echo "TZ=$VFD_TZ" > $VFD_ENV
            echo "TZ=$VFD_TZ" > $VFD_EN
        }
        echo "TZ=$VFD_TZ"
        sleep 1;
        exit 0
    }
}
exit 0
